# ─────────────────────────────────────────────────────────────────────────────
# Razorpay CloseLoop — LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# The LLM layer is an enhancement layer.
# The core financial workflow continues to work without an LLM.
# The LLM must NEVER become a financial authority.
# ─────────────────────────────────────────────────────────────────────────────

# Enable LLM (disabled by default — opt-in)
LLM_ENABLED=false

# Provider selection: openai | ollama | none
LLM_PROVIDER=openai

# ── OpenAI-Compatible Provider ───────────────────────────────────────────────
# API base URL (OpenAI, Azure OpenAI, or any compatible endpoint)
LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# API key — NEVER commit real keys to version control
LLM_OPENAI_API_KEY=sk-your-api-key-here

# Model name
LLM_OPENAI_MODEL=gpt-3.5-turbo

# Request timeout in seconds (must be > 0)
LLM_OPENAI_TIMEOUT=30.0

# Generation temperature (0.0 = deterministic, 2.0 = max random)
LLM_OPENAI_TEMPERATURE=0.0

# Maximum tokens to generate per request
LLM_OPENAI_MAX_TOKENS=1024

# Maximum retry attempts on transient failures (0 = no retries)
LLM_OPENAI_MAX_RETRIES=2

# ── Ollama / Local Provider ─────────────────────────────────────────────────
# Ollama server URL
LLM_OLLAMA_BASE_URL=http://localhost:11434

# Model name (must be available on the Ollama server)
LLM_OLLAMA_MODEL=llama3.2

# Request timeout in seconds (local models may need more time)
LLM_OLLAMA_TIMEOUT=60.0

# Generation temperature
LLM_OLLAMA_TEMPERATURE=0.0

# Maximum tokens to generate
LLM_OLLAMA_MAX_TOKENS=2048

# Maximum retry attempts
LLM_OLLAMA_MAX_RETRIES=1

# ── Logging ──────────────────────────────────────────────────────────────────
# LLM log level: DEBUG | INFO | WARNING | ERROR
LLM_LOG_LEVEL=INFO
